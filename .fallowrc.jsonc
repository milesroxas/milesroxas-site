{
  "$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",
  // CLI scripts run by hand (MIGRATIONS.md, src/features/ask/README.md, docs/composer-roadmap.md).
  "entry": [
    "scripts/add-missing-columns.ts",
    "scripts/backfill-ask-index.ts",
    "scripts/check-indexes.ts",
    "scripts/check-schema.ts",
    "scripts/compose-layouts.ts",
    "scripts/fix-indexes.ts",
    "scripts/mark-migration.ts"
  ],
  // Loaded by `payload migrate` from the configured migration directory.
  "dynamicallyLoaded": ["src/migrations/index.ts"],
  // Generated by `pnpm generate:db-schema`; nothing imports it.
  "ignorePatterns": ["src/payload-generated-schema.ts"],
  "ignoreExports": [
    // Generated, vendored, or a framework contract.
    { "file": "src/payload-types.ts", "exports": ["*"] },
    { "file": "src/migrations/*.ts", "exports": ["up", "down"] },
    { "file": "src/components/ui/**", "exports": ["*"] },
    { "file": "src/shared/testing/shadcn-helpers/**", "exports": ["*"] }
  ],
  "duplicates": {
    "ignore": [
      "src/payload-types.ts",
      "src/migrations/**",
      "src/app/(payload)/**",
      "src/components/ui/**",
      "src/shared/testing/shadcn-helpers/**"
    ],
    // globals.css scroll-fade-* utilities: Tailwind `@utility` bodies cannot share
    // declarations, and `@apply` between them is circular (see the file's comment).
    "ignoredClones": [
      "dup:21d3e957:3",
      "dup:6f552afd:2",
      "dup:b29c2648:2",
      "dup:0c1965c8:2",
      "dup:c907b4e1:2",
      "dup:406f6cd8:2",
      "dup:27787999:2",
      "dup:ba0c363f:2"
    ]
  },
  "health": {
    "ignore": [
      "src/payload-types.ts",
      "src/migrations/**",
      "src/app/(payload)/**",
      "src/components/ui/**",
      "src/shared/testing/shadcn-helpers/**",
      // A test file's `describe` callback is a suite, not a unit of production code.
      "**/*.test.ts",
      "**/*.test.tsx"
    ]
  }
}
