import "tokens/colors.elyx" as base

// Site palette, dark. Mirrors `palette-dark` in src/app/(frontend)/globals.css:
// the ink ground, where foreground and ground swap and orange stays the mark.
@context(theme="dark")
file {}

export darkColors = tokens : base.colors {
  background: rgb(5.88%, 5.49%, 7.0588%),
  foreground: .whitesmoke,
  muted: rgb(10.98%, 10.5882%, 12.549%),
