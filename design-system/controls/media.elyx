import "tokens/colors.elyx" as c
import "tokens/lengths.elyx" as l
import "controls/type.elyx" as t

// Stand-in for a block's media or Studio visual. Instances set width and height
// to the block's aspect ratio and relabel `mediaLabel` with the slot name.
export media = frame {
  width: 608px,
  height: 342px,
  layout: {justify-content: .center, align-items: .center},
  fill: c.colors.media,
  corner-radius: l.lengths.radius,
  children: mediaLabel,

  mediaLabel = text : t.mono {
    contents: "MEDIA 16:9",
    fill[0].color: c.colors.media-ink
  }
}

// Export sizes for every media slot, beside the stand-in it fills.
// Mirrors docs/media-dimensions.md (block by block); heroes and covers are
// measured from src/heros and src/sections. Update both when a frame changes.
exportSizes = frame {
  left: 1008px,
  top: 0px,
  width: 1792px,
  layout: {direction: .column, item-gap: 128px},
  fill: c.colors.background,
  padding: 96px,
  children: [
    exportIntro,
    exportRules,
    exportGrid,
    heroes,
    mediaContent,
    mediaBlocks,
    interactive
  ]
}

exportIntro = frame {
  width: 100%,
  layout: {direction: .column, item-gap: 24px},
  children: [exportTitle, exportNote]
}

exportTitle = text : t.display {
  contents: "Media export sizes",
  font-size: 72
}

exportNote = text : t.statement {
  width: 960px,
  contents: "The size to export each image or video at before uploading it. Every number is twice the widest the frame renders, so it stays sharp on retina screens. Cloudflare scales it down and picks the format per screen.",
  fill[0].color: c.colors.muted-foreground
}

rule1 = frame {
  width: 376px,
  layout: {direction: .column, item-gap: 12px},
  border: {color: c.colors.foreground, sides: .top},
  padding-top: 20px,
  children: [rule1Head, rule1Body]
}

rule1Head = text : t.blockHeading {
  width: 376px,
  contents: "Images at 2×",
  fill[0].color: c.colors.foreground
}

rule1Body = text : t.body {
  width: 376px,
  contents: "Export twice the widest the frame renders. Larger costs nothing on the page; smaller goes soft on retina.",
  fill[0].color: c.colors.muted-foreground
}

rule2 = frame {
  width: 376px,
  layout: {direction: .column, item-gap: 12px},
  border: {color: c.colors.foreground, sides: .top},
  padding-top: 20px,
  children: [rule2Head, rule2Body]
}

rule2Head = text : t.blockHeading {
  width: 376px,
  contents: "Video at 1080p",
  fill[0].color: c.colors.foreground
}

rule2Body = text : t.body {
  width: 376px,
  contents: "MP4 (H.264) at the frame's ratio. Stream stops at 1080p, so 4K adds nothing. 2560 only for a full-bleed hero.",
  fill[0].color: c.colors.muted-foreground
}

rule3 = frame {
  width: 376px,
  layout: {direction: .column, item-gap: 12px},
  border: {color: c.colors.foreground, sides: .top},
  padding-top: 20px,
  children: [rule3Head, rule3Body]
}

rule3Head = text : t.blockHeading {
  width: 376px,
  contents: "Crops come from the centre",
  fill[0].color: c.colors.foreground
}

rule3Body = text : t.body {
  width: 376px,
  contents: "There is no focal point. Export at the listed ratio and keep the subject in the middle.",
  fill[0].color: c.colors.muted-foreground
}

rule4 = frame {
  width: 376px,
  layout: {direction: .column, item-gap: 12px},
  border: {color: c.colors.foreground, sides: .top},
  padding-top: 20px,
  children: [rule4Head, rule4Body]
}

rule4Head = text : t.blockHeading {
  width: 376px,
  contents: "JPEG or PNG, under 10 MB",
  fill[0].color: c.colors.foreground
}

rule4Body = text : t.body {
  width: 376px,
  contents: "High-quality JPEG for photos, PNG for flat graphics. No AVIF: the upload refuses it. No need to make WebP.",
  fill[0].color: c.colors.muted-foreground
}

exportRules = frame {
  width: 100%,
  layout: {item-gap: 32px},
  children: [rule1, rule2, rule3, rule4]
}

