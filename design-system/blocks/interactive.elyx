              font-size: 16,
              line-height: 1.5
            }
          }
        }
      }
    }
  }
}

// Feature tabs, `featureTabs`: a centred tab strip over a copy and media panel.
// src/blocks/feature/Tabs/FeatureTabs.tsx
export featureTabs = frame {
  left: 4800px,
  width: l.lengths.page,
  layout: {direction: .column, align-items: .center, item-gap: 64px},
  fill: c.colors.background,
  padding: [l.lengths.band-normal, l.lengths.gutter],
  children: [tabStrip, panel],

  tabStrip = frame {
    layout: {align-items: .center, item-gap: 96px},
    children: [tabOne, tabTwo, tabThree],

    tabOne = text : t.heading {
      contents: "Tokens",
      fill[0].color: c.colors.primary
    }

    tabTwo = text : t.heading {
      contents: "Components",
      fill[0].color: c.colors.muted-foreground
    }

    tabThree = text : t.heading {
      contents: "Templates",
      fill[0].color: c.colors.muted-foreground
    }
  }

  panel = frame {
    width: 100%,
    layout: {item-gap: l.lengths.grid-gap},
    children: [panelCopy, panelMedia],

    panelCopy = frame {
      width: l.lengths.span-3,
      height: 432px,
      layout: {direction: .column, justify-content: .space-between},
      children: [panelOpener, panelList],

      panelOpener = frame {
        width: 100%,
        layout: {direction: .column, item-gap: 25px},
        children: [panelHeading, panelBody],

        panelHeading = text : t.blockHeading {
          width: 100%,
          contents: "Decisions made once"
        }

        panelBody = text : t.body {
          width: 100%,
          contents: "Colour, type, space and radius live in one file. Everything else reads from it."
        }
      }

      panelList = frame {
        width: 100%,
        layout: {direction: .column},
        children: [listLabel, listOne, listTwo, listThree],

        listLabel = frame {
          width: 100%,
          layout: {direction: .column},
          padding-bottom: 12px,
          children: listLabelText,

          listLabelText = text : t.small {
            contents: "Included",
            font-family: "Geist Mono",
            fill[0].color: c.colors.muted-foreground
          }
        }

        listOne = frame {
          width: 100%,
          layout: {direction: .column},
          border: {color: c.colors.border, sides: .bottom},
          padding: [4px, 0px],
          children: listOneText,

          listOneText = text : t.small {
            contents: "64 colour tokens across two themes"
          }
        }

        listTwo = frame {
          width: 100%,
          layout: {direction: .column},
          border: {color: c.colors.border, sides: .bottom},
          padding: [4px, 0px],
          children: listTwoText,

          listTwoText = text : t.small {
            contents: "A six-step fluid type scale"
          }
        }

        listThree = frame {
          width: 100%,
          layout: {direction: .column},
          padding-top: 4px,
          children: listThreeText,

          listThreeText = text : t.small {
            contents: "Spacing and radius scales"
          }
        }
      }
    }

    panelMedia = frame : m.media {
      width: l.lengths.span-5,
      height: 432px,
      overrides: [insert(captionCard, after = m.media.mediaLabel)],

      mediaLabel {
        contents: "VISUAL 16:9"
      }

      captionCard = frame {
        right: 32px,
        bottom: 36px,
        width: 288px,
        ignore-stack: .true,
        layout: {direction: .column},
        fill: c.colors.card,
        corner-radius: l.lengths.radius-md,
        padding: 16px,
        children: captionCardText,

        captionCardText = text : t.small {
          width: 100%,
          contents: "The token file, open beside the components that read from it.",
          fill[0].color: c.colors.muted-foreground
        }
      }
    }
  }
}
