  grid {
    layout.item-gap: 5px,

    opener {
      heading {
        font-size: 20,
        font-style: "Medium",
        line-height: 1.4
      }

      layout.item-gap: 0
    }

    deck {
      font-size: 16,
      line-height: 1.75
    }
  }
}

