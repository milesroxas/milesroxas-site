import "tokens/colors.elyx" as c
import "tokens/lengths.elyx" as l
import "controls/type.elyx" as t

// Section heading group: the openers a work page uses to start a section.
// Each base is the block with its CMS defaults; every other setting is a
// variant of it. Settings combine freely in the CMS: layout or size, the
// optional eyebrow and supporting copy, and the band theme are independent.
// Section heading (Standard), `richTransition`. Base: Offset layout, Small
// text, eyebrow and supporting copy shown, Default theme. A section heading
// titles the section after it, so its band has no bottom padding: the next
// band's top step (96px) is the gap, half the gap above it. Inside a Section
// it sits half the stack step above the next block (`STACK_OPENER`).
// src/blocks/rich-transition/RichTransition.tsx
export richTransition = frame {
  width: l.lengths.page,
  layout: {direction: .column},
  fill: c.colors.background,
  padding: [l.lengths.band-normal, l.lengths.gutter, 0px],
  children: grid,

  grid = frame {
    width: 100%,
    layout: {direction: .column, item-gap: 25px},
    padding-left: 160px,
    children: [opener, deck],

    opener = frame {
      width: l.lengths.span-4,
      layout: {direction: .column, item-gap: 5px},
      children: [eyebrow, heading],

      eyebrow = text : t.eyebrow {
        contents: "02 / Approach"
      }

      heading = text : t.title {
        width: 100%,
        contents: "One design system, built to hold up across product, marketing and print"
      }
    }

    deck = text : t.lead {
      width: l.lengths.span-3,
      contents: "The work started with an audit of every surface the brand appears on, then narrowed to the handful of decisions that shape all of them."
    }
  }
}

// Standard: Offset layout, Large text.
@variant
export richTransitionOffsetLarge = frame : richTransition {
  left: 1600px,

  grid {
    layout.item-gap: 24px,

    opener {
      layout.item-gap: 8px,

      heading {
        font-size: 44,
        line-height: 1.1
      }
    }

    deck {
      font-size: 24,
      line-height: 1.5
    }
  }
}

// Standard: Left layout. Heading on columns 1 to 4, copy beside it on 5 to 7.
@variant
export richTransitionLeft = frame : richTransition {
  left: 3200px,

  grid {
    layout.direction: .row,
    layout.item-gap: l.lengths.grid-gap,
    padding-left: 0px
  }
}

// Standard: Left layout, Large text.
@variant
export richTransitionLeftLarge = frame : richTransitionLeft {
  left: 4800px,

  grid {
    opener {
      layout.item-gap: 8px,

      heading {
        font-size: 44,
        line-height: 1.1
      }
    }

    deck {
      font-size: 24,
      line-height: 1.5
    }
  }
}

// Standard: Center layout.
@variant
export richTransitionCentered = frame : richTransition {
  left: 6400px,

  grid {
    opener {
      width: 768px,
      layout.align-items: .center,

      heading {
        align: .center
      }
    }

    deck {
      width: 640px,
      align: .center
    }

    layout.align-items: .center,
    layout.item-gap: 21px,
    padding-left: 0px
  }
}

