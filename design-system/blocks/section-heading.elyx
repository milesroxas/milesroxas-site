// Standard: Statement layout. Display type, centred; text size does not apply.
@variant
export richTransitionStatement = frame : richTransition {
  left: 12800px,

  grid {
    opener {
      width: 1024px,
      layout.align-items: .center,
      layout.item-gap: 25px,

      heading {
        contents: "One system, every surface",
        font-size: 96,
        line-height: 1.05,
        align: .center
      }
    }

    deck {
      width: 576px,
      align: .center
    }

    layout.align-items: .center,
    layout.item-gap: 73px,
    padding-left: 0px
  }
}

// Standard: Prose layout, heading level H2. On the reading column (3 to 6); sized against the article body, so text size does not apply.
@variant
export richTransitionProse = frame : richTransition {
  left: 14400px,
  padding-top: l.lengths.band-normal,
  padding-left: l.lengths.gutter,
  padding-right: l.lengths.gutter,

  grid {
    deck {
      width: l.lengths.span-4,
      contents: "Nine button styles, four type scales and three ways to show a price. None of it was wrong on its own. Together it made every new screen slower to design and harder to build."
    }

    layout.item-gap: 8px,

    opener {
      heading {
        contents: "What the audit found",
        font-size: 24,
        line-height: 1.375,
        letter-spacing: 0
      }

      layout.item-gap: 0
    }

    padding-left: 320px
  }
}

