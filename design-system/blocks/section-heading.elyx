// Standard: Inverted theme. The opposite palette to the visitor's.
@variant
export richTransitionInverted = frame : richTransition {
  left: 24000px,
  fill[0].color: c.colors.inverted-background,

  grid {
    opener {
      eyebrow {
        fill[0].color: c.colors.inverted-foreground
      }

      heading {
        fill[0].color: c.colors.inverted-foreground
      }
    }

    deck {
      fill[0].color: c.colors.inverted-foreground
    }
  }
}

// Standard: Neutral theme. A quiet stripe inside the visitor's palette.
@variant
export richTransitionNeutral = frame : richTransition {
  left: 25600px,
  fill[0].color: c.colors.neutral
}

// Standard: Brand theme.
@variant
export richTransitionBrand = frame : richTransition {
  left: 27200px,
  fill[0].color: c.colors.brand,

  grid {
    opener {
      eyebrow {
        fill[0].color: c.colors.brand-foreground
      }

      heading {
        fill[0].color: c.colors.brand-foreground
      }
    }

