// Section heading (Offset), `featureHeadingOffset`. Base: Small text, eyebrow
// and supporting copy shown, Default theme. It has no layout setting. A
// section heading like the Standard block, so its band has no bottom padding.
// src/blocks/feature/HeadingOffset/Component.tsx
export featureHeadingOffset = frame {
  top: 1400px,
  width: l.lengths.page,
  layout: {direction: .column},
  fill: c.colors.background,
  padding: [l.lengths.band-normal, l.lengths.gutter, 0px],
  children: grid,

  grid = frame {
    width: 100%,
    layout: {justify-content: .space-between},
    children: [opener, deckCell],

    opener = frame {
      width: l.lengths.span-4,
      layout: {direction: .column, item-gap: 4px},
      children: [eyebrow, heading],

      eyebrow = text : t.small {
        contents: "THE BRIEF",
        letter-spacing: 10%
      }

      heading = text : t.title {
        width: 100%,
        contents: "A retail brand that had outgrown the tools it launched with"
      }
    }

    deckCell = frame {
      width: l.lengths.span-3,
      layout: {direction: .column},
      padding-top: 96px,
      children: deck,

      deck = text : t.lead {
        width: 100%,
        contents: "Five years of fast growth left three codebases, two design files and no shared language between them. The goal was one source of truth the whole team could ship from.",
        fill[0].color: c.colors.muted-foreground
      }
    }
  }
}

// Offset: Large text.
@variant
export featureHeadingOffsetLarge = frame : featureHeadingOffset {
  left: 1600px,
  top: 1400px,

  grid {
    opener {
      layout.item-gap: 7px,

      heading {
