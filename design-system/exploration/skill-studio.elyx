use "resources/fonts/Geist-Variable.ttf"
use "resources/fonts/GeistMono-Regular.ttf"
use "resources/fonts/GeistPixel-Square.woff2"

import "./skill-studio-tokens.elyx" as k
import "resources/images/skill-studio/app/library.png" as shotLibrary
import "resources/images/skill-studio/app/editor.png" as shotEditor
import "resources/images/skill-studio/app/cases.png" as shotCases
import "resources/images/skill-studio/app/run.png" as shotRun
import "resources/images/skill-studio/app/all-cases.png" as shotAllCases
import "resources/images/skill-studio/app/results.png" as shotResults
import "resources/images/skill-studio/app/app.png" as shotApp
import "resources/images/skill-studio/lift-ribbon.svg" as liftRibbon
import "resources/icons/skill-studio-mark.svg" as flowMark
import "resources/icons/download.svg" as downloadGlyph
import "resources/icons/out.svg" as outGlyph
import "resources/icons/mark-mac.svg" as macMark
import "resources/icons/mark-windows.svg" as windowsMark
import "resources/icons/mark-linux.svg" as linuxMark
import "resources/icons/mark-github.svg" as githubMark
import "resources/images/skill-studio/windows/lint-check.jpg" as winChecks
import "resources/images/skill-studio/windows/suggest-rewrites.jpg" as winSuggest
import "resources/images/skill-studio/windows/chat-reply.jpg" as winChat
import "resources/images/skill-studio/windows/case-end.jpg" as winCase
import "resources/images/skill-studio/windows/design-end.jpg" as winDesign
import "resources/images/skill-studio/windows/results-marked.jpg" as winScores
import "resources/images/skill-studio/windows/compare-end.jpg" as winWords

file {
  draw-connections: .true
}

// Proposal: a page on milesroxas.com that gets people to install Skill Studio
// or contribute to it. The app flow comes first (real v0.16.0 screens from the
// app's own docs), then three pages at 1440px in the newest brand, then the
// App download block redesigned for both of its modes. Copy comes from the
// README, CONTRIBUTING and the promo lines Miles approved; numbers are the
// sample skill's (release-notes). Nothing here is built.
skillStudioMarketing = frame {
  layout: {direction: .column, item-gap: 192px},
  fill: k.brand.grey-1,
  padding: 120px,
  children: [intro, flowSheet, boards, blocksSheet],

  intro = frame {
    width: 1310px,
    layout: {direction: .column, item-gap: 24px},
    children: [introCode, introTitle, introNote],

    introCode = text : kit.meta {
      contents: "SKILL STUDIO / MARKETING PAGE / EXPLORATION / 2026-11-16"
    }

    introTitle = text : kit.display {
      contents: "three ways in",
      font-size: 154
    }

    introNote = text : kit.body {
      width: k.grid.span-7,
      contents: "The job: someone who writes agent skills downloads the app, and someone who builds tools opens the repo. Each page answers three questions in order: what is it, does it work, how do I get it. A Spec sheet is the brand as written. B Lift lets the product's own figure carry the opening. C Two doors pushes past the brand: the page forks into use it and build it before anything else."
    }
  }

  // The app as it ships (v0.16.0), in the order a new skill goes round the
  // loop. The page's sections borrow this order: write, run, compare.
  flowSheet = frame {
    layout: {direction: .column, item-gap: 48px},
    children: [flowHead, flowRow],

    flowHead = frame {
      width: 1310px,
      layout: {direction: .column, item-gap: 16px},
      children: [flowCode, flowTitle, flowNote],

      flowCode = text : kit.meta {
        contents: "01 / APP FLOW / V0.16.0 / SCREENS FROM DOCS/IMAGES"
      }

      flowTitle = text : kit.lead {
        contents: "library, skill, cases, run, results"
      }

      flowNote = text : kit.body {
        width: k.grid.span-7,
        contents: "One skill goes round the loop. The Library finds or starts it, the Skill screen holds its rules and versions, Cases are the test tasks, Run sends them to the agent, Results shows the lift and what each version missed. The page only needs three of these: Skill (write), Run, and Results (compare).",
        fill[0].color: k.brand.muted
      }
    }

    flowRow = frame {
      layout: {item-gap: 120px},
      children: [
        flowLibrary,
        flowSkill,
        flowCases,
        flowRun,
        flowLift,
        flowCompare
      ],

      flowLibrary = frame : kit.flowCard {
        connections[0].label: "open a skill",
        connections[0].target: flowSkill,

        flowWhat {
          contents: "Every skill on the machine, In progress first. Installed for Claude, Cursor, Codex."
        }

        flowStep {
          contents: "01 LIBRARY"
        }
      }

      flowSkill = frame : kit.flowCard {
        connections[0].label: "write cases",
        connections[0].target: flowCases,

        flowShot {
          fill[0].image.ref: shotEditor
        }

        flowWhat {
          contents: "SKILL.md and its files, versions with their scores, Write with AI. The rules are numbered."
        }

        flowStep {
          contents: "02 SKILL / WRITE"
        }
      }

      flowCases = frame : kit.flowCard {
        connections[0].label: "Run v1",
        connections[0].target: flowRun,

        flowShot {
          fill[0].image.ref: shotCases
        }

        flowWhat {
          contents: "A task asked the way you really would, files it needs, a good answer and its checks."
        }

        flowStep {
          contents: "03 CASES"
        }
      }

      flowRun = frame : kit.flowCard {
        connections[0].label: "graded by Jev",
        connections[0].target: flowLift,

        flowShot {
          fill[0].image.ref: shotRun
        }

        flowWhat {
          contents: "Claude Code or Cursor answers each case with the skill installed. Jev grades the results."
        }

        flowStep {
          contents: "04 RUN"
        }
      }

      flowLift = frame : kit.flowCard {
        connections[0].label: "open a case",
        connections[0].target: flowCompare,

        flowShot {
          fill[0].image.ref: shotAllCases
        }

        flowWhat {
          contents: "All cases: 85 at first runs, 98 now, 71 without the skill. The page's proof."
        }

        flowStep {
          contents: "05 RESULTS / LIFT"
        }
      }

      flowCompare = frame : kit.flowCard {
        flowShot {
          fill[0].image.ref: shotResults
        }

        flowWhat {
          contents: "Two versions side by side, with what each missed. You mark a verdict where you disagree."
        }

        flowStep {
          contents: "06 RESULTS / COMPARE"
        }
      }
    }
  }

  boards = frame {
    layout: {item-gap: 384px},
    children: [optionA, optionB, optionC],

    // A. Spec sheet. The brand as written: a spec-bar nav, one slogan-stack
    // moment in the opening with the lift panel on an ink field that runs off
    // three edges, then frame-only sections in the app's own order.
    optionA = frame {
      layout: {direction: .column, item-gap: 32px},
      children: [labelA, noteA, iaA, boardA],

      labelA = text : kit.lead {
        contents: "a. spec sheet"
      }

      noteA = text : kit.body {
        width: k.grid.span-9,
        contents: "The brand as written. The opening is the one moment: WRITE BETTER AI SKILLS in orange caps, yellow under SKILLS, the lift panel set as a band across an ink field that runs off the top, right and bottom (the view's one break). Below it everything is frame: numbered sections, spec blocks, a receipt for the downloads. Cheapest to build: it needs only the redesigned App download block.",
        fill[0].color: k.brand.muted
      }

      iaA = text : kit.meta {
        width: k.grid.span-12,
        contents: "IA / NAV / 01 OPENING + DOWNLOAD / 02 THE LOOP: WRITE, RUN, COMPARE / 03 PROOF: 71, 85, 98 / 04 INSTALL / 05 CONTRIBUTE / COLOPHON"
      }

      boardA = frame {
        title: "A. Spec sheet",
        caption: "The page at 1440px, top to bottom. One moment, in the opening.",
        width: k.grid.page,
        layout: {direction: .column},
        fill: k.brand.paper,
        children: [
          navA,
          openingA,
          loopA,
          proofA,
          installA,
          contributeA,
          colophonA
        ],

        navA = frame : kit.specBar {}

        openingA = frame {
          width: 100%,
          height: 860px,
          fill: k.brand.paper,
          children: [fieldA, codeA, markerA, hookA, lineA, ctaA, bandA],

          fieldA = frame {
            left: 839px,
            top: 0px,
            width: 601px,
            height: 100%,
            layout: {direction: .column, justify-content: .center},
            fill: k.brand.ink,
            children: liftBandA,

            liftBandA = frame {
              width: 100%,
              height: 300px,
              fill: {
                image: {
                  ref: shotAllCases,
                  sizing: {scale: 0.5464, offset: [-104.8px, 93.5px]}
                }
              }
            }
          }

          codeA = text : kit.meta {
            left: 65px,
            top: 64px,
            contents: "01 / A DESKTOP APP FOR WRITING AGENT SKILLS"
          }

          // The fluoro marker: yellow behind the lower 36% of the last line's
          // caps, 0.4 gutter past the word on each side.
          markerA = frame {
            left: 213px,
            top: 441px,
            width: 452px,
            height: 35px,
            fill: k.brand.fluoro
          }

          hookA = text : kit.moment {
            left: 65px,
            top: 128px,
            width: 757px,
            contents: "WRITE\nBETTER\nAI SKILLS",
            font-size: 136
          }

          lineA = text : kit.body {
            left: 65px,
            top: 548px,
            width: k.grid.span-5,
            contents: "Write the instructions your AI agent follows,\nthen test every change on real work."
          }

          ctaA = frame {
            left: 65px,
            top: 636px,
            layout: {align-items: .center, item-gap: 32px},
            children: [downloadA, repoLinkA],

            downloadA = frame : kit.downloadButton {}

            repoLinkA = frame : kit.textLink {
              linkLabel {
                contents: "Contribute on GitHub"
              }
            }
          }

          bandA = text : kit.meta {
            left: 65px,
            top: 788px,
            width: 757px,
            contents: "FREE / MIT / MAC, WINDOWS, LINUX / V0.16.0 / NO ACCOUNT, ANALYTICS OR CRASH REPORTING"
          }
        }

        loopA = frame {
          width: 100%,
          layout: {direction: .column, item-gap: 56px},
          border: {color: k.brand.ink, sides: .top},
          padding: [k.grid.section-loose, k.grid.margin, k.grid.section],
          children: [loopHeadA, loopColsA],

          loopHeadA = frame : kit.sectionHead {
            sectionCode {
              contents: "02 / THE LOOP"
            }

            sectionLead {
              contents: "Write the rules. Run an agent on a few real tasks. Compare what each version missed."
            }
          }

          loopColsA = frame {
            width: 100%,
            layout: {item-gap: k.grid.gutter},
            children: [stepWriteA, stepRunA, stepCompareA],

            stepWriteA = frame : kit.stepColumn {
              stepShot {
                fill[0].image.sizing: {scale: 0.3386, offset: [-88px, 0px]}
              }

              stepText {
                contents: "Write the skill's rules in a Markdown editor that numbers them, flags a vague one, and keeps every version with its score."
              }

              stepTop {
                stepName {
                  contents: "write"
                }
              }
            }

            stepRunA = frame : kit.stepColumn {
              stepShot {
                fill[0].image.ref: shotRun,
                fill[0].image.sizing: {scale: 0.37, offset: [-119.8px, 58px]}
              }

              stepText {
                contents: "Run an agent, Claude Code or Cursor, on a few test tasks called cases, with the skill installed."
              }

              stepTop {
                stepName {
                  contents: "run"
                }

                stepNumber {
                  contents: "02"
                }
              }
            }

            stepCompareA = frame : kit.stepColumn {
              stepShot {
                fill[0].image.ref: shotResults,
                fill[0].image.sizing: {scale: 0.29, offset: [-58.4px, -12.3px]}
              }

              stepText {
                contents: "Compare each version's answers side by side, with what each one missed."
              }

              stepTop {
                stepName {
                  contents: "compare"
                }

                stepNumber {
                  contents: "03"
                }
              }
            }
          }
        }

        proofA = frame {
          width: 100%,
          layout: {direction: .column, item-gap: 56px},
          padding: [k.grid.section-loose, k.grid.margin, k.grid.section],
          children: [proofHeadA, proofRowA],

          proofHeadA = frame : kit.sectionHead {
            sectionCode {
              contents: "03 / THE SAMPLE SKILL, RELEASE-NOTES"
            }

            sectionLead {
              contents: "The score says whether the edit helped, and how much the skill does at all."
            }
          }

          proofRowA = frame {
            width: 100%,
            layout: {item-gap: k.grid.gutter},
            children: [specsA, verdictA],

            specsA = frame {
              width: k.grid.span-4,
              layout: {direction: .column, item-gap: 40px},
              children: [specWithout, specFirst, specLatest, proofTextA],

              specWithout = frame : kit.specNumber {
                specLabel {
                  contents: "WITHOUT THE SKILL"
                }

                specValue {
                  contents: "71"
                }
              }

              specFirst = frame : kit.specNumber {
                specLabel {
                  contents: "FIRST RUNS, V0"
                }

                specValue {
                  contents: "85"
                }
              }

              specLatest = frame : kit.specNumber {
                specLabel {
                  contents: "LATEST RUNS, V1"
                }

                specValue {
                  contents: "98"
                }
              }

              proofTextA = text : kit.body {
                width: 100%,
                contents: "TypeSafe's Jev grades every answer against your rules and each case's checks. Where you disagree, you mark the verdict and the score follows."
              }
            }

            verdictA = frame {
              width: k.grid.span-8,
              height: 614px,
              fill: {
                image: {
                  ref: shotResults,
                  sizing: {scale: 0.5959, offset: [-119.2px, -4.2px]}
                }
              },
              border: {color: k.brand.ink, sides: .top}
            }
          }
        }

        installA = frame : kit.appDownloadReceipt {}

        contributeA = frame : kit.appDownloadRepo {}

        colophonA = frame : kit.colophon {}
      }
    }

    // B. Lift. The product's own figure carries the opening: the lift ribbon
    // from Results, drawn edge to edge on ink, with the change as a yellow
    // pixel readout. The headline drops to light display so the figure is the
    // one moment. The loop is one annotated window instead of three crops.
    optionB = frame {
      layout: {direction: .column, item-gap: 32px},
      children: [labelB, noteB, iaB, boardB],

      labelB = text : kit.lead {
        contents: "b. lift"
      }

      noteB = text : kit.body {
        width: k.grid.span-9,
        contents: "Proof first. The opening is ink, and the moment is the lift itself: the ribbon from Results drawn edge to edge (the view's one break), 85 rising to 98 over the dashed line at 71, the +13 as the one yellow readout. The headline is quiet light display, so nothing competes with the figure. The loop is one window with three numbered keys, and install becomes four keys, one per system.",
        fill[0].color: k.brand.muted
      }

      iaB = text : kit.meta {
        width: k.grid.span-12,
        contents: "IA / NAV ON INK / 01 OPENING: HEADLINE, DOWNLOAD, THE LIFT / 02 ONE WINDOW: 01 WRITE, 02 RUN, 03 COMPARE / 03 THE LAST WORD IS YOURS / 04 INSTALL: FOUR KEYS / 05 CONTRIBUTE / COLOPHON"
      }

      boardB = frame {
        title: "B. Lift",
        caption: "The page at 1440px. The moment is the figure, not the headline.",
        width: k.grid.page,
        layout: {direction: .column},
        fill: k.brand.paper,
        children: [
          navB,
          openingB,
          windowB,
          verdictB,
          installB,
          contributeB,
          colophonB
        ],

        navB = frame : kit.specBar {
          border[0].color: k.brand.rule-on-ink,
          fill[0].color: k.brand.ink,

          barCode {
            fill[0].color: k.brand.muted-on-ink
          }

          barLinks {
            linkGuide {
              fill[0].color: k.brand.paper
            }

            linkContribute {
              fill[0].color: k.brand.paper
            }

            linkInstall {
              fill[0].color: k.brand.paper
            }

            linkHow {
              fill[0].color: k.brand.paper
            }
          }

          barName {
            fill[0].color: k.brand.paper
          }
        }

        openingB = frame {
          width: 100%,
          height: 900px,
          fill: k.brand.ink,
          children: [
            codeB,
            headB,
            lineB,
            ctaB,
            readoutB,
            readoutLabelB,
            ribbonB,
            firstLabelB,
            firstValueB,
            latestLabelB,
            latestValueB,
            withoutLabelB
          ],

          codeB = text : kit.meta {
            left: 65px,
            top: 56px,
            contents: "01 / A DESKTOP APP FOR WRITING AGENT SKILLS",
            fill[0].color: k.brand.muted-on-ink
          }

          headB = text : kit.display {
            left: 65px,
            top: 104px,
            width: k.grid.span-7,
            contents: "write better\nai skills",
            fill[0].color: k.brand.paper
          }

          lineB = text : kit.body {
            left: 65px,
            top: 300px,
            width: k.grid.span-5,
            contents: "Write the instructions your AI agent follows,\nthen test every change on real work.",
            fill[0].color: k.brand.muted-on-ink
          }

          ctaB = frame {
            left: 65px,
            top: 380px,
            layout: {align-items: .center, item-gap: 32px},
            children: [downloadB, repoLinkB],

            downloadB = frame : kit.downloadButton {
              fill[0].color: k.brand.paper,

              downloadMeta {
                fill[0].color: k.brand.muted
              }

              downloadLabel {
                fill[0].color: k.brand.ink
              }
            }

            repoLinkB = frame : kit.textLink {
              linkLabel {
                fill[0].color: k.brand.paper,
                contents: "Contribute on GitHub"
              }
            }
          }

          readoutB = text {
            left: 1006px,
            top: 96px,
            fill: k.brand.fluoro,
            contents: "+13",
            font-size: 176,
            font-family: "Geist Pixel",
            line-height: 0.9
          }

          readoutLabelB = text : kit.meta {
            left: 1012px,
            top: 268px,
            width: 360px,
            contents: "SINCE EACH CASE'S FIRST RUN\nTHE SAMPLE SKILL, 3 CASES",
            fill[0].color: k.brand.muted-on-ink
          }

          ribbonB = asset {
            left: 0px,
            top: 400px,
            width: 1440px,
            height: 480px,
            contents: liftRibbon
          }

          firstLabelB = text : kit.meta {
            left: 65px,
            top: 674px,
            contents: "FIRST RUNS, V0",
            fill[0].color: k.brand.muted-on-ink
          }

          firstValueB = text : kit.body {
            left: 65px,
            top: 727px,
            contents: "85",
            font-family: "Geist Mono",
            fill[0].color: k.brand.ink
          }

          latestLabelB = text : kit.meta {
            left: 1263px,
            top: 534px,
            contents: "LATEST RUNS, V1",
            fill[0].color: k.brand.muted-on-ink
          }

          latestValueB = text : kit.body {
            left: 1351px,
            top: 587px,
            contents: "98",
            font-family: "Geist Mono",
            fill[0].color: k.brand.ink
          }

          withoutLabelB = text : kit.meta {
            left: 1220px,
            top: 826px,
            contents: "WITHOUT THE SKILL, 71",
            fill[0].color: k.brand.muted-on-ink
          }
        }

        windowB = frame {
          width: 100%,
          layout: {direction: .column, item-gap: 56px},
          padding: [k.grid.section-loose, k.grid.margin, k.grid.section],
          children: [windowHeadB, windowRowB],

          windowHeadB = frame : kit.sectionHead {
            sectionCode {
              contents: "02 / ONE WINDOW"
            }

            sectionLead {
              contents: "The rules, the test tasks and the scores sit in one window, so an edit and its result are one click apart."
            }
          }

          windowRowB = frame {
            width: 100%,
            layout: {item-gap: k.grid.gutter},
            children: [keysB, appShotB],

            keysB = frame {
              width: k.grid.span-3,
              layout: {direction: .column, item-gap: 32px},
              children: [keyWriteB, keyRunB, keyCompareB],

              keyWriteB = frame : kit.legendKey {
                keyTop {
                  keyChip {
                    keyDigit {
                      contents: "01"
                    }
                  }

                  keyName {
                    contents: "write"
                  }
                }

                keyText {
                  contents: "The Skill screen: the rules, numbered, and every version with its score."
                }
              }

              keyRunB = frame : kit.legendKey {
                keyTop {
                  keyChip {
                    keyDigit {
                      contents: "02"
                    }
                  }

                  keyName {
                    contents: "run"
                  }
                }

                keyText {
                  contents: "Run v1 sends each case to Claude Code or Cursor with the skill installed."
                }
              }

              keyCompareB = frame : kit.legendKey {
                keyTop {
                  keyChip {
                    keyDigit {
                      contents: "03"
                    }
                  }

                  keyName {
                    contents: "compare"
                  }
                }

                keyText {
                  contents: "Results: two versions side by side, with what each one missed."
                }
              }
            }

            appShotB = frame {
              width: k.grid.span-9,
              height: 782.6px,
              fill: {image: {ref: shotApp}},
              border: {color: k.brand.ink, position: .outside},
              children: [pinWriteB, pinRunB, pinCompareB],

              pinWriteB = frame : kit.keyChip {
                left: 118px,
                top: 84px,

                keyDigit {
                  contents: "01"
                }
              }

              pinRunB = frame : kit.keyChip {
                left: 770px,
                top: 6px,

                keyDigit {
                  contents: "02"
                }
              }

              pinCompareB = frame : kit.keyChip {
                left: 506px,
                top: 152px,

                keyDigit {
                  contents: "03"
                }
              }
            }
          }
        }

        verdictB = frame {
          width: 100%,
          layout: {item-gap: k.grid.gutter},
          padding: [k.grid.section, k.grid.margin, k.grid.section-loose],
          children: [verdictShotB, verdictTextB],

          verdictShotB = frame {
            width: k.grid.span-6,
            height: 517px,
            fill: {
              image: {
                ref: shotResults,
                sizing: {scale: 0.92, offset: [145.9px, 192.2px]}
              }
            },
            border: {color: k.brand.ink, sides: .top}
          }

          verdictTextB = frame {
            width: k.grid.span-6,
            layout: {direction: .column, item-gap: 32px},
            padding: [0px, 0px, 0px, 111px],
            children: [verdictCodeB, verdictLeadB, verdictBodyB, verdictSpecsB],

            verdictCodeB = text : kit.meta {
              contents: "03 / THE LAST WORD"
            }

            verdictLeadB = text : kit.lead {
              width: 100%,
              contents: "Jev grades every answer. Where you disagree, your mark wins."
            }

            verdictBodyB = text : kit.body {
              width: 100%,
              contents: "TypeSafe's Jev grades each answer against your rules and each case's checks. A score counts the rules and checks met. Mark a verdict and the score follows.",
              fill[0].color: k.brand.muted
            }

            verdictSpecsB = frame {
              width: 100%,
              layout: {direction: .column},
              children: [specFilesB, specSuitsB],

              specFilesB = frame : kit.needRow {
                needLabel {
                  width: k.grid.span-1,
                  contents: "FILES"
                }

                needValue {
                  width: 424px,
                  contents: "Runs, scores and your corrections are plain files in the skill's evals/ folder."
                }
              }

              specSuitsB = frame : kit.needRow {
                needLabel {
                  width: k.grid.span-1,
                  contents: "SUITS"
                }

                needValue {
                  width: 424px,
                  contents: "Work that is a matter of judgement: writing, web pages, agent process."
                }
              }
            }
          }
        }

        installB = frame : kit.appDownloadKeys {}

        contributeB = frame : kit.appDownloadRepo {}

        colophonB = frame : kit.colophon {}
      }
    }

    // C. Two doors. Past the brand: the first viewport forks. One slogan
    // stack split across two grounds, USE IT on orange for people who write
    // skills, BUILD IT on ink for people who build tools, with the Flow mark
    // cropped by the corner. Below, a field manual and a deadpan receipt.
    optionC = frame {
      layout: {direction: .column, item-gap: 32px},
      children: [labelC, noteC, iaC, boardC],

      labelC = text : kit.lead {
        contents: "c. two doors"
      }

      noteC = text : kit.body {
        width: k.grid.span-9,
        contents: "Pushes past the brand on purpose. The page forks before it explains: an orange door with USE IT and the download, an ink door with BUILD IT and the repo, the Skill Studio mark cropped by the ink door's corner. It breaks two rules: an orange ground at full height, and two grounds in the first view. Below, the loop is a field manual (a 90° label down the margin, big light numerals) and the facts close as a receipt.",
        fill[0].color: k.brand.muted
      }

      iaC = text : kit.meta {
        width: k.grid.span-12,
        contents: "IA / NAV / 01 TWO DOORS: USE IT (DOWNLOAD) + BUILD IT (REPO) / 02 FIELD MANUAL: 01 WRITE, 02 RUN, 03 COMPARE / 03 RECEIPT + READOUT / 04 INSTALL / COLOPHON"
      }

      boardC = frame {
        title: "C. Two doors",
        caption: "The page at 1440px. The first view forks into use and build.",
        width: k.grid.page,
        layout: {direction: .column},
        fill: k.brand.paper,
        children: [navC, doorsC, manualC, receiptC, installC, colophonC],

        navC = frame : kit.specBar {}

        doorsC = frame {
          width: 100%,
          height: 860px,
          layout: {direction: .row},
          children: [doorUse, doorBuild],

          doorUse = frame {
            width: 720px,
            height: 100%,
            fill: k.brand.spot,
            children: [useCode, useWord, useLine, useCta, useFoot],

            useCode = text : kit.meta {
              left: 65px,
              top: 56px,
              contents: "FOR PEOPLE WHO WRITE SKILLS",
              fill[0].color: k.brand.ink
            }

            useWord = text : kit.moment {
              left: 58px,
              top: 120px,
              contents: "USE\nIT",
              font-size: 190,
              letter-spacing: -3%,
              fill[0].color: k.brand.ink
            }

            useLine = text : kit.body {
              left: 65px,
              top: 560px,
              width: 430px,
              contents: "Write the instructions your AI agent follows,\nthen test every change on real work."
            }

            useCta = frame : kit.downloadButton {
              left: 65px,
              top: 648px
            }

            useFoot = text : kit.meta {
              left: 65px,
              top: 788px,
              contents: "FREE / ALSO FOR WINDOWS AND LINUX / V0.16.0",
              fill[0].color: k.brand.ink
            }
          }

          doorBuild = frame {
            width: 720px,
            height: 100%,
            fill: k.brand.ink,
            children: [
              buildMark,
              buildCode,
              buildWord,
              buildLine,
              buildCta,
              buildCommand
            ],

            buildMark = asset {
              left: 330px,
              top: 560px,
              width: 478px,
              height: 395px,
              fill: k.brand.grey-ink,
              contents: flowMark
            }

            buildCode = text : kit.meta {
              left: 119px,
              top: 56px,
              contents: "FOR PEOPLE WHO BUILD TOOLS",
              fill[0].color: k.brand.muted-on-ink
            }

            buildWord = text : kit.moment {
              left: 112px,
              top: 120px,
              contents: "BUILD\nIT",
              font-size: 190,
              letter-spacing: -3%,
              fill[0].color: k.brand.paper
            }

            buildLine = text : kit.body {
              left: 119px,
              top: 560px,
              width: 430px,
              contents: "Open source under MIT. Judge packs, engine\nadapters, fixes and UI work are welcome.",
              fill[0].color: k.brand.paper
            }

            buildCta = frame : kit.textLink {
              left: 119px,
              top: 660px,

              linkLabel {
                fill[0].color: k.brand.paper,
                contents: "Open the repository"
              }
            }

            buildCommand = text : kit.meta {
              left: 119px,
              top: 788px,
              contents: "PNPM INSTALL / PNPM DEV / PNPM CHECK",
              fill[0].color: k.brand.muted-on-ink
            }
          }
        }

        manualC = frame {
          width: 100%,
          layout: {direction: .column, item-gap: 96px},
          padding: [k.grid.section-loose, k.grid.margin, k.grid.section],
          children: [
            manualHeadC,
            chapterWriteC,
            chapterRunC,
            chapterCompareC,
            spineC
          ],

          manualHeadC = frame : kit.sectionHead {
            sectionCode {
              contents: "02 / FIELD MANUAL"
            }

            sectionLead {
              contents: "Three screens, one loop. Go round it until the score stops moving."
            }
          }

          chapterWriteC = frame : kit.chapter {
            chapterShot {
              fill[0].image.sizing: {scale: 0.58, offset: [-140.2px, 88.7px]}
            }

            chapterWords {
              chapterText {
                contents: "Write the skill's rules. The editor numbers them, flags a vague one, and keeps each version with its score."
              }
            }
          }

          chapterRunC = frame : kit.chapter {
            chapterShot {
              fill[0].image.ref: shotRun,
              fill[0].image.sizing: {scale: 0.7, offset: [-246.3px, 201.4px]}
            }

            chapterWords {
              chapterText {
                contents: "Run an agent, Claude Code or Cursor, on a few test tasks called cases, with the skill installed."
              }

              chapterName {
                contents: "run"
              }
            }

            chapterNumber {
              contents: "02"
            }
          }

          chapterCompareC = frame : kit.chapter {
            chapterShot {
              fill[0].image.ref: shotResults,
              fill[0].image.sizing: {scale: 0.5, offset: [-102px, 1.5px]}
            }

            chapterWords {
              chapterText {
                contents: "Compare each version's answers side by side, with what each one missed. Mark a verdict where you disagree."
              }

              chapterName {
                contents: "compare"
              }
            }

            chapterNumber {
              contents: "03"
            }
          }

          // The page's one 90° element, down the left margin.
          spineC = frame {
            left: 22px,
            top: 1500px,
            width: 420px,
            height: 20px,
            transform: [0, 1, 0, -1, 0, 0],
            ignore-stack: .true,
            children: spineText,

            spineText = text : kit.meta {
              contents: "SKILL STUDIO / FIELD MANUAL / V0.16.0"
            }
          }
        }

        receiptC = frame {
          width: 100%,
          layout: {item-gap: k.grid.gutter},
          border: {color: k.brand.ink, sides: .top},
          padding: [k.grid.section, k.grid.margin, k.grid.section-loose],
          children: [receiptHeadC, receiptListC, readoutC],

          receiptHeadC = frame {
            width: k.grid.span-3,
            layout: {direction: .column, item-gap: 16px},
            children: [receiptCodeC, receiptNoteC],

            receiptCodeC = text : kit.meta {
              contents: "03 / RECEIPT"
            }

            receiptNoteC = text : kit.body {
              width: 100%,
              contents: "Scores are the sample skill's, release-notes, over 3 cases.",
              fill[0].color: k.brand.muted
            }
          }

          receiptListC = frame {
            width: k.grid.span-5,
            layout: {direction: .column},
            children: [
              lineFree,
              lineLicense,
              lineAccount,
              lineAnalytics,
              lineCrash,
              lineWithout,
              lineFirst,
              lineLatest,
              lineTotal
            ],

            lineFree = frame : kit.receiptLine {}

            lineLicense = frame : kit.receiptLine {
              lineLabel {
                contents: "LICENSE"
              }

              lineValue {
                contents: "MIT"
              }
            }

            lineAccount = frame : kit.receiptLine {
              lineLabel {
                contents: "ACCOUNTS"
              }

              lineValue {
                contents: "0"
              }
            }

            lineAnalytics = frame : kit.receiptLine {
              lineLabel {
                contents: "ANALYTICS"
              }

              lineValue {
                contents: "0"
              }
            }

            lineCrash = frame : kit.receiptLine {
              lineLabel {
                contents: "CRASH REPORTS"
              }

              lineValue {
                contents: "0"
              }
            }

            lineWithout = frame : kit.receiptLine {
              lineLabel {
                contents: "SCORE WITHOUT THE SKILL"
              }

              lineValue {
                contents: "71"
              }
            }

            lineFirst = frame : kit.receiptLine {
              lineLabel {
                contents: "FIRST RUNS, V0"
              }

              lineValue {
                contents: "85"
              }
            }

            lineLatest = frame : kit.receiptLine {
              lineLabel {
                contents: "LATEST RUNS, V1"
              }

              lineValue {
                contents: "98"
              }
            }

            lineTotal = frame : kit.receiptLine {
              padding-top: 16px,
              padding-left: 0px,
              padding-bottom: 0px,
              padding-right: 0px,
              border[0].color: k.brand.ink,
              border[0].sides: .top,
              border[0].width: 2px,

              lineLabel {
                fill[0].color: k.brand.ink,
                contents: "LIFT"
              }

              lineValue {
                contents: "+13"
              }
            }
          }

          readoutC = frame {
            width: k.grid.span-4,
            height: 320px,
            layout: {direction: .column, justify-content: .space-between},
            fill: k.brand.ink,
            padding: 24px,
            children: [readoutTopC, readoutDigitsC],

            readoutTopC = text : kit.meta {
              contents: "LIFT / SINCE FIRST RUNS",
              fill[0].color: k.brand.muted-on-ink
            }

            readoutDigitsC = text {
              fill: k.brand.fluoro,
              contents: "+13",
              font-size: 176,
              font-family: "Geist Pixel",
              line-height: 0.9
            }
          }
        }

        installC = frame : kit.appDownloadReceipt {}

        colophonC = frame : kit.colophon {}
      }
    }
  }

  // The App download block (src/blocks/app-download) redesigned for the new
  // brand, in both of its modes. Download buttons becomes a receipt (one row
  // per file, the detected system marked in orange) or four keys (B). GitHub repository becomes
  // a parts list: what is welcome, where it lives, and the three commands.
  blocksSheet = frame {
    layout: {direction: .column, item-gap: 48px},
    children: [blocksHead, blocksRow],

    blocksHead = frame {
      width: 1310px,
      layout: {direction: .column, item-gap: 16px},
      children: [blocksCode, blocksTitle, blocksNote],

      blocksCode = text : kit.meta {
        contents: "BLOCKS / APP DOWNLOAD, REDESIGNED"
      }

      blocksTitle = text : kit.lead {
        contents: "app download: receipt and parts list"
      }

      blocksNote = text : kit.body {
        width: k.grid.span-7,
        contents: "Same fields as the block today (heading, description, version, a file and size per system, releases link, repository link, clone command). The detected system's row is the current item, so it carries the orange square and the ink button. Sizes stay out until the release lists them.",
        fill[0].color: k.brand.muted
      }
    }

    blocksRow = frame {
      layout: {direction: .column, item-gap: 96px},
      children: [blockReceipt, blockKeys, blockRepo],

      blockReceipt = frame : kit.appDownloadReceipt {
        title: "App download / Download buttons"
      }

      blockKeys = frame : kit.appDownloadKeys {
        title: "App download / Download buttons, keys variant"
      }

      blockRepo = frame : kit.appDownloadRepo {
        title: "App download / GitHub repository"
      }
    }
  }
}

// Parts the sheets instance. Text styles follow the brand's three size classes:
// metadata 11, body 17, large (moment or display) at 8x metadata or more, plus
// the 1.9x body lead the site's sections allow.
kit = frame {
  left: 3800px,
  top: -4705px,
  layout: {direction: .column, item-gap: 64px},
  fill: k.brand.grey-1,
  padding: 64px,
  children: [
    meta,
    body,
    lead,
    display,
    moment,
    textLink,
    downloadButton,
    specBar,
    sectionHead,
    stepColumn,
    specNumber,
    flowCard,
    appDownloadReceipt,
    appDownloadRepo,
    receiptRow,
    needRow,
    partRow,
    legendKey,
    keyChip,
    chapter,
    receiptLine,
    appDownloadKeys,
    osKey,
    statement,
    navOnInk,
    featureState,
    hero,
    example,
    walkState,
    dlPrimary,
    dlSecondary,
    archSwitch,
    installBlock,
    repoBlock,
    colophon
  ],

  meta = text {
    fill: k.brand.muted,
    contents: "METADATA",
    font-size: 11,
    font-family: "Geist Mono",
    line-height: 1.4,
    letter-spacing: 6%
  }

  body = text {
    fill: k.brand.ink,
    contents: "Body copy, sentence case.",
    font-size: 17,
    font-family: "Geist",
    font-style: "Regular",
    line-height: 1.5
  }

  lead = text {
    fill: k.brand.ink,
    contents: "lead statement",
    font-size: 32,
    font-family: "Geist",
    font-style: "Light",
    line-height: 1.1,
    letter-spacing: -2%
  }

  display = text {
    fill: k.brand.ink,
    contents: "display",
    font-size: 88,
    font-family: "Geist",
    font-style: "Light",
    line-height: 0.98,
    letter-spacing: -3.5%
  }

  moment = text {
    fill: k.brand.spot,
    contents: "MOMENT",
    font-size: 154,
    font-family: "Geist",
    font-style: "Black",
    line-height: 0.88,
    letter-spacing: -5%
  }

  // A link under 24px is ink text over a 3px orange rule (orange text needs 24px).
  textLink = frame {
    layout: {direction: .column, item-gap: 2px},
    border: {color: k.brand.spot, width: 3px, sides: .bottom},
    padding: [0px, 0px, 2px],
    children: linkLabel,

    linkLabel = text : body {
      contents: "Read CONTRIBUTING.md"
    }
  }

  // Ink is the button; orange is only the glyph, as the block now ships.
  downloadButton = frame {
    layout: {align-items: .center, item-gap: 12px},
    fill: k.brand.ink,
    padding: [16px, 24px],
    children: [downloadIcon, downloadLabel, downloadMeta],

    downloadIcon = asset {
      width: 20px,
      height: 20px,
      fill: k.brand.spot,
      contents: downloadGlyph
    }

    downloadLabel = text : body {
      contents: "Download for Mac",
      fill[0].color: k.brand.paper
    }

    downloadMeta = text : meta {
      contents: "APPLE SILICON",
      fill[0].color: k.brand.muted-on-ink
    }
  }

  // Spec-bar nav: name left, lowercase links, code right, a 1px rule below.
  specBar = frame {
    width: 1440px,
    height: 64px,
    layout: {justify-content: .space-between, align-items: .center},
    fill: k.brand.paper,
    border: {color: k.brand.ink, sides: .bottom},
    padding: [0px, 65px],
    children: [barName, barLinks, barCode],

    barName = text : body {
      contents: "skill studio",
      font-style: "Light"
    }

    barLinks = frame {
      layout: {align-items: .center, item-gap: 32px},
      children: [linkHow, linkInstall, linkContribute, linkGuide],

      linkHow = text : body {
        contents: "how it works",
        font-style: "Light"
      }

      linkInstall = text : body {
        contents: "install",
        font-style: "Light"
      }

      linkContribute = text : body {
        contents: "contribute",
        font-style: "Light"
      }

      linkGuide = text : body {
        contents: "guide",
        font-style: "Light"
      }
    }

    barCode = text : meta {
      contents: "V0.16.0 / 2026-11-15"
    }
  }

  // A section's head: the numbered code over three columns, the lead
  // statement from column four.
  sectionHead = frame {
    width: 1310px,
    layout: {item-gap: k.grid.gutter},
    children: [sectionCode, sectionLead],

    sectionCode = text : meta {
      width: k.grid.span-3,
      contents: "00 / SECTION"
    }

    sectionLead = text : lead {
      width: k.grid.span-7,
      contents: "lead statement"
    }
  }

  stepColumn = frame {
    width: k.grid.span-4,
    layout: {direction: .column, item-gap: 16px},
    children: [stepTop, stepText, stepShot],

    stepTop = frame {
      width: 100%,
      layout: {item-gap: 16px},
      border: {color: k.brand.ink, sides: .top},
      padding: [16px, 0px, 0px],
      children: [stepNumber, stepName],

      stepNumber = text : meta {
        contents: "01"
      }

      stepName = text : body {
        contents: "step",
        font-style: "Light"
      }
    }

    stepText = text : body {
      width: 100%,
      height: 104px,
      contents: "What the step does."
    }

    stepShot = frame {
      width: 100%,
      height: 416px,
      fill: {image: {ref: shotEditor}}
    }
  }

  // A spec block: label above value, the value in light display.
  specNumber = frame {
    width: 100%,
    layout: {direction: .column, item-gap: 8px},
    border: {color: k.brand.ink, sides: .top},
    padding: [12px, 0px, 0px],
    children: [specLabel, specValue],

    specLabel = text : meta {
      contents: "LABEL"
    }

    specValue = text : display {
      contents: "00"
    }
  }

  flowCard = frame {
    width: 533px,
    layout: {direction: .column, item-gap: 16px},
    children: [flowShot, flowStep, flowWhat],

    flowShot = frame {
      width: 533px,
      height: 426px,
      fill: {image: {ref: shotLibrary}},
      border: {color: k.brand.grey-2, position: .outside}
    }

    flowStep = text : meta {
      contents: "00 SCREEN",
      fill[0].color: k.brand.ink
    }

    flowWhat = text : body {
      width: 100%,
      contents: "What happens here."
    }
  }

  // App download, Download buttons mode, as a receipt.
  appDownloadReceipt = frame {
    width: 1440px,
    layout: {item-gap: k.grid.gutter},
    fill: k.brand.paper,
    padding: [k.grid.section-loose, k.grid.margin, k.grid.section],
    children: [receiptIntro, receiptBody],

    receiptIntro = frame {
      width: k.grid.span-4,
      layout: {direction: .column, item-gap: 24px},
      children: [receiptCode, receiptHeading, receiptText],

      receiptCode = text : meta {
        contents: "04 / INSTALL"
      }

      receiptHeading = text : lead {
        width: 100%,
        contents: "download for your computer"
      }

      receiptText = text : body {
        width: 100%,
        contents: "The app updates itself after that. Every version is on Releases.",
        fill[0].color: k.brand.muted
      }
    }

    receiptBody = frame {
      width: k.grid.span-8,
      layout: {direction: .column},
      children: [
        receiptVersion,
        rowMacArm,
        rowMacIntel,
        rowWindows,
        rowLinux,
        receiptNeeds,
        needAgent,
        needKey,
        needWriter,
        receiptFoot
      ],

      receiptVersion = frame {
        width: 100%,
        layout: {justify-content: .space-between},
        border: {color: k.brand.ink, sides: .bottom},
        padding: [0px, 0px, 12px],
        children: [versionLabel, versionValue],

        versionLabel = text : meta {
          contents: "FILE"
        }

        versionValue = text : meta {
          contents: "V0.16.0 / 2026-11-15"
        }
      }

      rowMacArm = frame {
        width: 100%,
        height: 72px,
        layout: {align-items: .center, item-gap: 16px},
        border: {color: k.brand.grey-2, sides: .bottom},
        children: [armMark, armSystem, armLeader, armFile, armButton],

        armMark = frame {
          width: 11px,
          height: 11px,
          fill: k.brand.spot
        }

        armSystem = text : body {
          contents: "macOS, Apple silicon"
        }

        armLeader = frame {
          height: 1px,
          border: {color: k.brand.muted, dash: [1px, 5px], sides: .top}
        }

        armFile = text : meta {
          contents: "SKILL-STUDIO-MAC-ARM64.DMG",
          fill[0].color: k.brand.ink
        }

        armButton = frame : downloadButton {
          padding-top: 12px,
          padding-left: 20px,
          padding-bottom: 12px,
          padding-right: 20px,

          downloadLabel {
            contents: "Download"
          }

          downloadMeta {
            contents: "DETECTED"
          }
        }
      }

      rowMacIntel = frame : receiptRow {}

      rowWindows = frame : receiptRow {
        rowSystem {
          contents: "Windows, 64-bit"
        }

        rowFile {
          contents: "SKILL-STUDIO-WIN-X64.EXE"
        }
      }

      rowLinux = frame : receiptRow {
        rowSystem {
          contents: "Linux, x86-64"
        }

        rowFile {
          contents: "SKILL-STUDIO-LINUX-X86_64.APPIMAGE"
        }
      }

      receiptNeeds = frame {
        width: 100%,
        padding: [56px, 0px, 12px],
        children: needsLabel,

        needsLabel = text : meta {
          contents: "YOU ALSO NEED"
        }
      }

      needAgent = frame : needRow {}

      needKey = frame : needRow {
        needLabel {
          contents: "GRADER"
        }

        needValue {
          contents: "A TypeSafe API key, added under Settings. Without it, no rule or check is marked."
        }
      }

      needWriter = frame : needRow {
        needLabel {
          contents: "OPTIONAL"
        }

        needValue {
          contents: "To write with AI: the claude or codex CLI signed in, or an Anthropic or OpenAI API key."
        }
      }

      receiptFoot = frame {
        width: 100%,
        layout: {item-gap: 32px},
        padding: [32px, 0px, 0px],
        children: [allReleases, checkDownload],

        allReleases = frame : textLink {
          linkLabel {
            contents: "All releases"
          }
        }

        checkDownload = frame : textLink {
          border[0].color: k.brand.grey-2,
          border[0].width: 1,

          linkLabel {
            contents: "Check a download"
          }
        }
      }
    }
  }

  // App download, GitHub repository mode, as a parts list.
  appDownloadRepo = frame {
    width: 1440px,
    layout: {item-gap: k.grid.gutter},
    fill: k.brand.paper,
    border: {color: k.brand.ink, sides: .top},
    padding: [k.grid.section-loose, k.grid.margin],
    children: [repoIntro, repoBody],

    repoIntro = frame {
      width: k.grid.span-4,
      layout: {direction: .column, item-gap: 24px},
      children: [repoCode, repoHeading, repoText, repoLinks],

      repoCode = text : meta {
        contents: "05 / CONTRIBUTE"
      }

      repoHeading = text : lead {
        width: 100%,
        contents: "open source, MIT"
      }

      repoText = text : body {
        width: 100%,
        contents: "Fixes and new parts are welcome. For anything larger than a fix, open an issue first so we can agree on the shape.",
        fill[0].color: k.brand.muted
      }

      repoLinks = frame {
        layout: {direction: .column, item-gap: 16px},
        padding: [16px, 0px, 0px],
        children: [repoGitHub, repoGuide],

        repoGitHub = frame : textLink {
          linkLabel {
            contents: "Open the repository"
          }
        }

        repoGuide = frame : textLink {
          border[0].color: k.brand.grey-2,
          border[0].width: 1
        }
      }
    }

    repoBody = frame {
      width: k.grid.span-8,
      layout: {direction: .column, item-gap: 48px},
      children: [partsList, cloneBlock],

      partsList = frame {
        width: 100%,
        layout: {direction: .column},
        children: [partsHead, partJudge, partEngine, partUi, partFix],

        partsHead = frame : partRow {
          padding-top: 0px,
          padding-bottom: 12px,
          border[0].color: k.brand.ink,

          partWhere {
            fill[0].color: k.brand.muted,
            contents: "WHERE"
          }

          partName {
            fill[0].color: k.brand.muted,
