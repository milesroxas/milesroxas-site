        featureSpecBody = text : kit.body {
          width: k.grid.span-6,
          contents: "The section pins for three viewport heights and the scroll drives it one to one. Between beats, over the same 40% of a viewport: the next verb brightens as the last one dims, the sentence under them swaps, and the screen cross-fades while it settles from 104% to 100%, a slow push in. Each beat crops the app to the one place it talks about. With reduced motion, or on a phone, nothing pins: the three beats stack, verb, sentence, screen. Built on sticky positioning and a CSS scroll timeline, not a scripted entrance, so it stays inside the one reveal system.",
          fill[0].color: k.brand.muted
        }
