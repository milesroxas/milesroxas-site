    r3Mobile = frame {
      title: "Lift R3 / 390",
      caption: "First screen on a phone.",
      width: 390px,
      height: 844px,
      fill: k.brand.ink,
      children: [m3Nav, m3Head, m3Line, m3Note, m3Readout, m3Caption, m3Ribbon],

      m3Nav = text : kit.body {
        left: 18px,
        top: 20px,
        contents: "miles roxas",
        font-style: "Light",
        fill[0].color: k.brand.paper
      }

      m3Head = text : kit.hero {
        left: 18px,
        top: 96px,
        width: 354px,
        contents: "write better\nai skills",
        font-size: 52,
        fill[0].color: k.brand.paper
      }

      m3Line = text : kit.body {
        left: 18px,
        top: 228px,
        width: 350px,
        contents: "A skill is a page of instructions your AI assistant reads before it does a task for you. Skill Studio helps you write one, then shows whether each change made the results better.",
        font-size: 16,
        fill[0].color: k.brand.muted-on-ink
      }

      m3Note = frame {
        left: 18px,
        top: 378px,
        width: 354px,
        layout: {item-gap: 10px},
        children: [m3NoteDot, m3NoteText],

        m3NoteDot = frame {
          width: 6px,
          height: 6px,
          fill: k.brand.spot
        }

        m3NoteText = text : kit.body {
          width: 330px,
          contents: "Skill Studio is a desktop app. Open this page on a Mac, Windows or Linux computer to install it.",
          font-size: 16,
          fill[0].color: k.brand.paper
        }
      }

      m3Readout = text {
        left: 18px,
        top: 492px,
        fill: k.brand.fluoro,
        contents: "+13",
        font-size: 72,
        font-family: "Geist Pixel",
        line-height: 0.9
      }

      m3Caption = text : kit.body {
        left: 18px,
        top: 568px,
        width: 340px,
        contents: "The sample skill went from 85 to 98 out of 100 after one change.",
        font-size: 16,
        fill[0].color: k.brand.muted-on-ink
      }

      m3Ribbon = asset {
        left: -40px,
        top: 690px,
        width: 470px,
        height: 157px,
        contents: liftRibbon
      }
    }

    r3Deltas = frame {
      title: "Brand changes, round three",
      caption: "Adds to round two's sheet. Fold into miles-visual-brand once Miles agrees.",
      width: 960px,
      layout: {direction: .column, item-gap: 40px},
      fill: k.brand.paper,
      padding: 64px,
      children: [d3Title, d3List],

      d3Title = text : kit.statement {
        width: 100%,
        contents: "what changed again",
        font-size: 44
      }

      d3List = frame {
        width: 100%,
        layout: {direction: .column, item-gap: 28px},
        children: [d3a, d3b, d3c, d3d, d3e],

        d3a = text : kit.body {
          width: 100%,
          contents: "10. Sizes, refined. Display has two steps on a page: 72 for the opening line and 44 for statements and step names. The pixel readout is 120. Rule 6's floor drops from 8x metadata to 4x. Impact comes from the ground and the contrast, light type in paper on ink, not from size."
        }

        d3b = text : kit.body {
          width: 100%,
          contents: "11. A product screen is shown whole: the full window, as filmed, never a crop of a corner. Focus comes from what the copy beside it says, or from the plates' dimming, never from cutting the rest away."
        }

        d3c = text : kit.body {
          width: 100%,
          contents: "12. Copy assumes a reader new to the product and the field. Every product word (skill, case, grading) is explained the first time it appears, or replaced by a plain one (example task, score). Tool names come after what they do."
        }

        d3d = text : kit.body {
          width: 100%,
          contents: "13. A walkthrough outline may have two levels: steps in display, their features in body. The current feature carries the orange square, the brand's mark for the current item."
        }

        d3e = text : kit.body {
          width: 100%,
          contents: "14. Dim on the grey field is #b4b4b7, the partner of round two's dim ink."
        }
      }
    }
  }
}

// How it works, redesigned (2026-11-16). Four patterns for the walkthrough,
// two states each. Every window is the whole app; text and windows share top
// edges and sit on the 12-column grid.
howItWorks = frame {
  left: -2664px,
  top: 19500px,
  layout: {direction: .column, item-gap: 160px},
  fill: k.brand.grey-1,
  padding: 120px,
  children: [hiwIntro, hiwA, hiwB, hiwC, hiwD],

  hiwIntro = frame {
    width: 1310px,
    layout: {direction: .column, item-gap: 24px},
    children: [hiwTitle, hiwNote],

    hiwTitle = text : kit.display {
      contents: "how it works, four ways",
      font-size: 88
    }

    hiwNote = text : kit.body {
      width: 867.67px,
      contents: "Round three put the outline at one height, the sentence at another and the window at a third, so a feature's name sat far from what it meant. Each pattern here keeps a feature's name, sentence and window together. A and B pin one stage while you scroll, C slides a strip sideways, D stacks sheets. My pick is B: the pin shows where in the app each feature lives, which a reader new to the product needs most.",
      fill[0].color: k.brand.muted
    }
  }

  hiwA = frame {
    layout: {item-gap: 288px},
    children: [hiwANote, hiwA1, hiwA2],

    hiwANote = frame {
      width: 425.33px,
      layout: {direction: .column, item-gap: 24px},
      children: [hiwATitle, hiwABody],

      hiwATitle = text : kit.statement {
        width: 100%,
        contents: "a. outline, grouped",
        font-size: 44
      }

      hiwABody = text : kit.body {
        width: 100%,
        contents: "The walkthrough as a table of contents. The current feature opens in place, its sentence right under its name, so a feature and its description are never apart. Outline and window share a top edge at 179 and the window fills columns 5 to 12. Closest to round three, fixed.",
        fill[0].color: k.brand.muted
      }
    }

    hiwA1 = frame {
