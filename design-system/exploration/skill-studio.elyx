          delta1,
          delta2,
          delta3,
          delta4,
          delta5,
          delta6,
          delta7,
          delta8,
          delta9
        ],

        delta1 = text : kit.body {
          width: 100%,
          contents: "1. Sections are named by a statement, not a code. One line of light display, six words or fewer, lowercase. The numbered index (02 / the loop) stays for lists and case study chapters, never as a section eyebrow."
        }

        delta2 = text : kit.body {
          width: 100%,
          contents: "2. Grounds separate sections, rules do not. Paper, the grey field and ink take turns. A line is allowed only when it carries data (a chart baseline) or marks a thing to press (the 3px orange underline)."
        }

        delta3 = text : kit.body {
          width: 100%,
          contents: "3. The grey field (#e6e6e6) becomes a named ground, for the one section a page sets apart."
        }

        delta4 = text : kit.body {
          width: 100%,
          contents: "4. Marketing pages drop the 1.9x lead size. Three classes again: metadata 11, body 17, display or moment 88 and up."
        }

        delta5 = text : kit.body {
          width: 100%,
          contents: "5. Metadata is for facts a reader checks (a version, a file type), at most one group per view. Labels that only name what follows are cut."
        }

        delta6 = text : kit.body {
          width: 100%,
          contents: "6. The nav names the site, not the page: miles roxas, then work, posts, contact. The product's name lives in the page's first sentence."
        }

        delta7 = text : kit.body {
          width: 100%,
          contents: "7. The App download block keeps its behaviour (it detects the system and the Mac's chip) and takes three changes: square corners instead of 6px, notes at body size instead of 14px, and no Other systems or Or clone it labels, since the buttons say what they are."
        }

        delta9 = text : kit.body {
          width: 100%,
          contents: "9. One pinned feature per page at most, for a sequence the reader steps through. Scroll drives it one to one; it never plays on its own. Unvisited steps sit in a dim ink (#3a393f) on the ink ground, so the list of steps is also the progress."
        }

        delta8 = text : kit.body {
          width: 100%,
          contents: "8. To settle before building: the site grid is 8 columns with a 96px gutter; the brand says 12 columns, margin 4.5%, gutter 1.2%. This page draws the brand's grid."
        }
      }
    }
  }
}

// Round three: Lift for a reader new to all of it (2026-11-16). App screens
