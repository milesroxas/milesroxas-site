import "blocks/media.elyx" as media
import "blocks/opening.elyx" as opening
import "resources/images/image-3.png" as image-3
import "blocks/interactive.elyx" as interactive
import "resources/images/skill-studio/skill-studio-intro-library.png" as plateLibrary
import "resources/images/skill-studio/skill-studio-walkthrough.png" as plateWalkthrough
import "resources/images/skill-studio/skill-studio-one-screen.png" as plateOneScreen
import "resources/images/skill-studio/skill-studio-mark-met.png" as plateMarkMet
import "resources/images/skill-studio/skill-studio-selection-tools.png" as plateSelectionTools
