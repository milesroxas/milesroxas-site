{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "pnpm run ci",
  "ignoreCommand": "bash scripts/vercel-ignore-build.sh",
  "git": {
    "deploymentEnabled": {
      "*": false,
      "main": true,
      "dev": true
    }
  },
  "functions": {
    "src/app/**/*": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/payload-jobs/run",
      "schedule": "10 5 * * *"
    }
  ]
}
