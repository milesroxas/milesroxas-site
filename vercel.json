{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "pnpm run ci",
  "ignoreCommand": "bash scripts/vercel-ignore-build.sh",
  "git": {
    "deploymentEnabled": {
      "*": false,
      "main": true,
      "dev": false
    }
  },
  "functions": {
    "src/app/**/*": {
      "maxDuration": 60
    }
  }
}
