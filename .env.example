# Database connection string (Vercel Postgres/Neon/Local)
POSTGRES_URL=postgres://postgres:<password>@127.0.0.1:5432/your-database-name

# Used to encrypt JWT tokens
PAYLOAD_SECRET=YOUR_SECRET_HERE

# Public site URL used for absolute links. No trailing slash.
# In production on Vercel, set this to your canonical domain: https://your-domain.com
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Secret used to authenticate cron jobs
CRON_SECRET=YOUR_CRON_SECRET_HERE

# Used to validate preview requests
PREVIEW_SECRET=YOUR_SECRET_HERE

# Vercel Blob read/write token (optional if using Vercel Blob storage)
BLOB_READ_WRITE_TOKEN=

# Resend (optional)
RESEND_API_KEY=

# Cloudflare Images + Stream
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_IMAGES_ACCOUNT_HASH=
CLOUDFLARE_STREAM_CUSTOMER_SUBDOMAIN=
CLOUDFLARE_STREAM_WEBHOOK_SECRET=

# Comma-separated access keys for protected works (?access=<key>)
WORK_ACCESS_KEYS=

# Vercel Blob store base URL, e.g. https://<storeId>.public.blob.vercel-storage.com
# Optional — derived from BLOB_READ_WRITE_TOKEN when unset
BLOB_BASE_URL=

# Microsoft Clarity (optional)
CLARITY_ID=
