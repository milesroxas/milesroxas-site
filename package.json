{
  "name": "milesroxas",
  "version": "1.0.0",
  "description": "Website template for Payload",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "cross-env NODE_OPTIONS=\"--no-deprecation --dns-result-order=ipv4first\" next build --webpack",
    "postbuild": "next-sitemap --config next-sitemap.config.cjs",
    "migrate:status": "cross-env NODE_OPTIONS=--no-deprecation tsx scripts/migrate-status-prod.ts",
    "cms:upload": "cross-env NODE_OPTIONS=--no-deprecation tsx --env-file=.env scripts/cms-upload.ts",
    "check:migrations": "cross-env NODE_OPTIONS=--no-deprecation tsx scripts/check-migration-enum-safety.ts",
    "check:migrations:drift": "cross-env NODE_OPTIONS=--no-deprecation tsx --env-file=.env scripts/check-migration-drift.ts",
    "migrate:create": "cross-env NODE_OPTIONS=--no-deprecation payload migrate:create",
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev --turbopack",
    "dev:tui": "cross-env NODE_OPTIONS=--no-deprecation tsx scripts/dev-tui/index.tsx",
    "dev:prod": "cross-env NODE_OPTIONS=--no-deprecation rm -rf .next && pnpm build && pnpm start",
    "generate:db-schema": "cross-env NODE_OPTIONS=--no-deprecation payload generate:db-schema",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "ii": "cross-env NODE_OPTIONS=--no-deprecation pnpm install",
    "kill:3000": "lsof -ti:3000 | xargs kill -9 || true",
    "lint": "biome lint --write .",
    "lint:check": "biome lint .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "check": "biome check --write .",
    "lint:ci": "biome ci .",
    "ci": "pnpm guard:preview-db && cross-env NODE_OPTIONS=\"--no-deprecation --dns-result-order=ipv4first\" payload migrate && pnpm build",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "reinstall": "cross-env NODE_OPTIONS=--no-deprecation rm -rf node_modules && rm pnpm-lock.yaml && pnpm install",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test:storybook": "vitest run --project storybook",
    "test:unit": "vitest run --project unit",
    "db:up": "docker compose up postgres -d",
    "db:down": "docker compose down",
    "db:reset": "docker compose down -v && docker compose up postgres -d",
    "guard:preview-db": "cross-env NODE_OPTIONS=--no-deprecation tsx scripts/guard-preview-db.ts",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.78",
    "@ai-sdk/react": "^4.0.119",
    "@gsap/react": "^2.1.2",
    "@microsoft/clarity": "^1.0.2",
    "@payloadcms/admin-bar": "3.90.2",
    "@payloadcms/db-vercel-postgres": "3.90.2",
    "@payloadcms/email-resend": "3.90.2",
    "@payloadcms/live-preview-react": "3.90.2",
    "@payloadcms/next": "3.90.2",
    "@payloadcms/plugin-form-builder": "3.90.2",
    "@payloadcms/plugin-mcp": "3.90.2",
    "@payloadcms/plugin-nested-docs": "3.90.2",
    "@payloadcms/plugin-redirects": "3.90.2",
    "@payloadcms/plugin-search": "3.90.2",
    "@payloadcms/plugin-seo": "3.90.2",
    "@payloadcms/richtext-lexical": "3.90.2",
    "@payloadcms/storage-vercel-blob": "3.90.2",
    "@payloadcms/ui": "3.90.2",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tabs": "^1.1.21",
    "@react-three/fiber": "9.8.1",
    "@shadcn/react": "^0.2.1",
    "@tabler/icons-react": "^3.48.0",
    "@tailwindcss/typography": "^0.5.20",
    "@typesafe-ai/sdk": "^0.6.0",
    "@vercel/analytics": "^2.0.1",
    "ai": "^7.0.116",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cross-env": "^10.1.0",
    "dotenv": "^18.0.4",
    "elkjs": "^0.12.0",
    "embla-carousel-react": "^8.6.0",
    "geist": "^1.7.2",
    "graphql": "^16.14.2",
    "gsap": "^3.15.0",
    "hls.js": "^1.7.3",
    "lenis": "^1.3.26",
    "lite-youtube-embed": "^0.3.4",
    "lucide-react": "^1.48.0",
    "next": "16.3.6",
    "next-sitemap": "^4.2.3",
    "payload": "3.90.2",
    "postgres": "^3.4.9",
    "posthog-js": "^1.434.14",
    "posthog-node": "^5.54.1",
    "prism-react-renderer": "^2.4.1",
    "prismjs": "1.30.0",
    "radix-ui": "^1.6.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-hook-form": "7.88.0",
    "recharts": "^3.10.1",
    "sharp": "0.35.4",
    "tailwind-merge": "3.7.0",
    "three": "^0.186.1",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@storybook/addon-a11y": "10.6.0",
    "@storybook/addon-docs": "10.6.0",
    "@storybook/addon-themes": "10.6.0",
    "@storybook/addon-vitest": "10.6.0",
    "@storybook/nextjs-vite": "10.6.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/react": "16.3.2",
    "@types/escape-html": "^1.0.4",
    "@types/node": "22.20.4",
    "@types/pg": "^8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "^0.186.0",
    "@vitest/browser": "4.1.11",
    "@vitest/browser-playwright": "4.1.11",
    "dotenv-cli": "^11.0.0",
    "execa": "^10.0.1",
    "ink": "^7.1.1",
    "ink-spinner": "^5.0.0",
    "jsdom": "29.1.1",
    "playwright": "^1.63.0",
    "postcss": "^8.5.28",
    "storybook": "10.6.0",
    "tailwindcss": "^4.3.3",
    "ts-node": "^10.9.2",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "^8.3.1",
    "vitest": "4.1.11"
  },
  "peerDependencies": {
    "pg-cloudflare": "1.1.1"
  },
  "packageManager": "pnpm@10.28.0+sha512.05df71d1421f21399e053fde567cea34d446fa02c76571441bfc1c7956e98e363088982d940465fd34480d4d90a0668bc12362f8aa88000a64e83d0b0e47be48",
  "engines": {
    "node": "^18.20.2 || >=20.9.0",
    "pnpm": "^10"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "bufferutil",
      "core-js",
      "esbuild",
      "protobufjs",
      "sharp",
      "unrs-resolver",
      "utf-8-validate"
    ],
    "patchedDependencies": {
      "@payloadcms/drizzle": "patches/@payloadcms__drizzle.patch",
      "@payloadcms/plugin-mcp": "patches/@payloadcms__plugin-mcp.patch"
    }
  }
}
