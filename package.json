    "@tailwindcss/typography": "^0.5.19",
    "@types/escape-html": "^1.0.4",
    "@types/node": "22.5.4",
    "@types/pg": "^8.16.0",
    "@types/react": "19.1.8",
    "@types/react-dom": "19.1.6",
    "@types/three": "^0.170.0",
    "copyfiles": "^2.4.1",
    "dotenv-cli": "^8.0.0",
    "glslify-loader": "^2.0.0",
    "postcss": "^8.5.6",
    "raw-loader": "^4.0.2",
    "tailwindcss": "^4.1.18",
    "ts-node": "^10.9.2",
    "typescript": "5.8.3",
    "vite-tsconfig-paths": "5.1.4",
    "vitest": "3.2.3"
  },
  "peerDependencies": {
    "pg-cloudflare": "1.1.1"
  },
  "engines": {
    "node": "^18.20.2 || >=20.9.0",
    "pnpm": "^9 || ^10"
  },
  "pnpm": {
