# Vercel ignore file
# Files and directories to exclude from Vercel deployment

# Development
.env.local
.env.development

# Build outputs (will be rebuilt on Vercel)
.next/
out/

# Dependencies
node_modules/

# Testing
**/*.test.ts
**/*.test.tsx
**/*.spec.ts
**/*.spec.tsx
__tests__/
coverage/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Misc
.DS_Store
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
