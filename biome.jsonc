{
  "$schema": "https://biomejs.dev/schemas/2.6.2/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true,
    "defaultBranch": "dev"
  },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "**",
      // Generated by Payload and Next: never hand-edited, never linted or formatted.
      "!src/payload-types.ts",
      "!src/payload-generated-schema.ts",
      "!src/app/(payload)/admin/importMap.js",
      "!src/migrations",
      "!src/stories/block-controls/manifest.generated.json",
      // Not source: design files, published client reports, vector assets.
      "!design-system",
      "!public/reports",
      "!**/*.svg",
      // Prose, lockfile and tooling config keep their own shape; Biome covers code.
      "!**/*.md",
      "!**/*.mdx",
      "!**/*.yml",
      "!**/*.yaml",
      "!**/*.scss"
    ]
  },
  "formatter": {
    "indentStyle": "space",
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "asNeeded"
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "tailwind": {
    "attributes": ["class", "className"],
    "mergeFunctions": ["cn", "clsx"],
    "variantFunctions": ["cva"]
  },
  "linter": {
    "domains": {
      "next": "recommended",
      "react": "recommended",
      "test": "recommended"
    },
    "rules": {
      "correctness": {
        "useExhaustiveDependencies": {
          "level": "error",
          "options": {
            // A dependency listed only to re-run an effect (a route change, a
            // replay key) is deliberate here, as React's own hooks lint allows.
            // Missing dependencies are still errors.
            "reportUnnecessaryDependencies": false
          }
        }
      },
      "nursery": {
        // Tailwind classes in one order, so a diff shows a change and not a shuffle.
        "useTailwindSortedClasses": "error"
      }
    }
  },
  "overrides": [
    {
      // shadcn/ui components as upstream ships them, so they stay diffable against
      // it: upstream's class order, its role="group" divs, its index keys on
      // positional lists (error lists, slider thumbs, code lines).
      "includes": ["src/components/ui/**", "src/shared/testing/shadcn-helpers/**"],
      "linter": {
        "rules": {
          "a11y": {
            "useKeyWithClickEvents": "off",
            "useSemanticElements": "off"
          },
          "nursery": {
            "useTailwindSortedClasses": "off"
          },
          "suspicious": {
            "noArrayIndexKey": "off"
          }
        }
      }
    },
    {
      // The Payload admin does not bundle next/image; a plain <img> is the only image there.
      "includes": ["src/plugins/streak-studio/**"],
      "linter": {
        "rules": {
          "performance": {
            "noImgElement": "off"
          }
        }
      }
    }
  ]
}
